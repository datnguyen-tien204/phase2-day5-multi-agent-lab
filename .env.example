# Required if using a real LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional tracing providers
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Optional search provider
TAVILY_API_KEY=
SEARXNG_BASE_URL=http://localhost:8088
SEARXNG_TIMEOUT_SECONDS=10
SEARCH_FETCH_TOP_K=4
SEARCH_FETCH_TIMEOUT_SECONDS=6

# Runtime config
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=60
